{
    "name": "wppoland/bileto",
    "description": "Event tickets for WooCommerce: attendees, QR codes, ticket transfer and check-in.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "brianhenryie/strauss": "^0.22",
        "chillerlan/php-qrcode": "^5.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/woocommerce-stubs": "^10.8",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Bileto\\": "src/"
        },
        "classmap": [
            "vendor-prefixed/"
        ]
    },
    "scripts": {
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs:fix": "phpcbf --standard=phpcs.xml.dist",
        "analyse": "phpstan analyse -c phpstan.neon.dist --memory-limit=2G",
        "test": "php tests/uninstall-check.php",
        "prefix-namespaces": "strauss",
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "Bileto\\Vendor\\",
            "classmap_prefix": "Bileto_Vendor_",
            "constant_prefix": "BILETO_VENDOR_",
            "packages": [
                "chillerlan/php-qrcode"
            ],
            "delete_vendor_packages": true
        }
    }
}
